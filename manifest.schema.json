{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/besoecho/besoloom/blob/main/manifest.schema.json",
  "title": "Beso Loom Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "status",
    "repository"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^0\\|[1-9]\\d*\\.0\\|[1-9]\\d*\\.0\\|[1-9]\\d*$"
    },
    "status": {
      "type": "string",
      "enum": ["bootstrap", "development", "stable", "deprecated"]
    },
    "repository": {
      "type": "string",
      "format": "uri"
    }
  }
}
